        <DCCReference Include="Tests.Filters.pas"/>
        <DCCReference Include="Tests.Lifetime.pas"/>
        <DCCReference Include="Tests.Backpressure.pas"/>
        <DCCReference Include="Tests.VclTargets.pas"/>
