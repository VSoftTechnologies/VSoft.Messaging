# DPM package spec file
metadata:
  id: VSoft.Messaging
  version: 0.4.3
  description: VSoft.Messaging is a libary that provides an internal synchronous/asynchronous publish/subscribe messaging system for Delphi applications.
  authors:
    - Vincent Parrett
  projectUrl: https://github.com/VSoftTechnologies/VSoft.Messaging
  repositoryUrl: https://github.com/VSoftTechnologies/VSoft.Messaging
  repositoryCommit: ad29b3e4a958bbed46d90297abde7c7d2c53e1f1
  license: Apache-2.0
  copyright: Vincent Parrett and contributors
  tags:
    - messaging
    - publish
    - subscribe
  readme: README.md
variables:
  packagesource: Rad Studio $compilernoprefix$
targetPlatforms:
  # package folder names are a mess. 
  - compiler from: delphixe2
    compiler to: delphi13.0
    platforms:
      - win32
      - win64
templates:
  - name: default
    source:
      - src: ./src/*.pas
      - src: ./packages/$packageSource$/*.dpk
        dest: ./packages/$packageSource$
      - src: ./packages/$packageSource$/*.dproj
        dest: ./packages/$packageSource$
    build:
      - project: ./packages/$packageSource$/VSoft.MessagingR.dproj
